# Settings for docker-compose.yml / docker-compose.prod.yml (copy to .env).
# This file is not meant for running the API directly with uvicorn: the API
# reads .env from its working directory and rejects keys it does not know.

# PostgreSQL (applied when the data volume is created)
POSTGRES_USER=affinities
POSTGRES_PASSWORD=affinities
POSTGRES_DB=affinities
POSTGRES_PORT=5432

# pgAdmin (docker-compose.yml only)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# API (DATABASE_URL is built by Compose from the POSTGRES_* values)
API_PORT=8000
# CORS origins (comma-separated for multiple, or "*" for all)
CORS_ORIGINS=*

# Path prefix behind a reverse proxy. In docker-compose.yml it is passed to
# both the API (FastAPI root_path, default empty) and the frontend (base path
# of the UI, default "/").
# ROOT_PATH=/affinity

# Frontend
FRONTEND_PORT=3000
# API base URL used by the browser; written to config.js at container start
VITE_API_URL=http://localhost:8000
